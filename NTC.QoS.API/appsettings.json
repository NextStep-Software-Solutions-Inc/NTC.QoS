{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hangfire": {
    "WorkerCount": 10
  },
  "ConnectivityCache": {
    "InfrastructureCacheHours": 24,
    "SpeedStatsCacheHours": 4,
    "TechnologyCacheHours": 12,
    "AssessmentCacheHours": 8,
    "MaxCacheSizeMB": 200
  }
}