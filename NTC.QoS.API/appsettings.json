{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "RequestResponseLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "VerboseApiLogging": {
    "Enabled": true,
    "LogRequestBody": true,
    "LogResponseBody": true,
    "LogRequestHeaders": true,
    "LogResponseHeaders": true,
    "MaxBodySizeToLog": 10485760,
    "HeadersToRedact": [
      "Authorization",
      "Cookie",
      "Set-Cookie",
      "X-API-Key",
      "X-Auth-Token"
    ],
    "QueryParamsToRedact": [
      "password",
      "token",
      "apiKey",
      "api_key",
      "secret"
    ],
    "BodyPropertiesToRedact": [
      "password",
      "confirmPassword",
      "currentPassword",
      "newPassword",
      "oldPassword",
      "apiKey",
      "api_key",
      "secretKey",
      "secret_key",
      "token",
      "accessToken",
      "access_token",
      "refreshToken",
      "refresh_token",
      "creditCard",
      "cardNumber",
      "cvv",
      "ssn"
    ],
    "RedactionText": "[REDACTED]",
    "ExcludedPaths": [
      "/health",
      "/metrics",
      "/favicon.ico"
    ],
    "LogFilePath": "logs/api-requests-.txt",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 104857600
  },
  "Hangfire": {
    "WorkerCount": 10
  },
  "DefaultAdmin": {
    "Email": "nssqos2025@gmail.com",
    "FirstName": "System",
    "LastName": "Administrator"
  },
  "ConnectivityCache": {
    "InfrastructureCacheHours": 24,
    "SpeedStatsCacheHours": 4,
    "TechnologyCacheHours": 12,
    "AssessmentCacheHours": 8,
    "MaxCacheSizeMB": 200
  },
  "AzureBlobStorage": {
    "MaxFileSizeMB": 50,
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/csv",
      "image/jpeg",
      "image/png",
      "image/gif",
      "text/plain"
    ],
    "UseDevelopmentStorage": false,
    "AccessLevel": "Private"
  }
}