{
  "Clerk": {
    "Authority": "https://clerk.qos.ntc.gov.ph",
    "FrontendUrl": "https://app.qos.ntc.gov.ph",
    "AuthorizedParties": [
      "https://qos.vercel.app",
      "https://qos.ntc.gov.ph",
      "https://www.qos.ntc.gov.ph",
      "https://app.qos.ntc.gov.ph",
      "https://qos.nextstep-software.com",
      "https://www.qos.nextstep-software.com",
      "https://app.qos.nextstep-software.com"
    ]
  },
  "Database": {
    "RunMigrationsOnStartup": true,
    "ForceReseed": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5
  },
  "Hangfire": {
    "WorkerCount": 4,
    "MaxWorkerCount": 16,
    "ServerName": "Development-Server",
    "EnableDashboardMetrics": true,
    "AutoRetry": {
      "Attempts": 2,
      "LogEvents": true,
      "OnAttemptsExceeded": "Delete"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://qos.ntc.gov.ph",
      "https://www.qos.ntc.gov.ph",
      "https://app.qos.ntc.gov.ph"
    ]
  }
}